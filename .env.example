# Runtime environment name — defaults to the current git branch (main → production).
# Set explicitly in environments without a git checkout (Docker, CI).
ENVIRONMENT=development

# Required
DISCORD_TOKEN=your_discord_bot_token
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
REDIS_URL=redis://localhost:6379

# Postgres play-history archive (docs/POSTGRES_HISTORY_PLAN.md) — REQUIRED.
# Postgres is the durable home of play history; the bot refuses to start without
# it. `docker compose up` brings the server up alongside redis.
#
# POSTGRES_PASSWORD is MANDATORY and has no fallback by design — compose fails
# the command outright if it is unset or empty, because a defaulted password
# would start the database with a credential nobody chose. Do not put a
# placeholder here: any non-empty value satisfies the check and would ship as
# the real credential.
#
# Run ./setup_env.sh to derive one from DISCORD_TOKEN. USER and DB default to
# "musicbot" if left unset.
# POSTGRES_USER=musicbot
POSTGRES_PASSWORD=
# POSTGRES_DB=musicbot
#
# Running Postgres yourself instead of the compose service? Set the URL directly
# — env_file passes it straight through to the bot, and it overrides the
# compose-built one only if you also comment out the POSTGRES_URL line in
# docker-compose.yml.
# POSTGRES_URL=postgresql://user:password@host:5432/dbname

# Optional — where the bgutil PO-token provider sidecar listens (docker-compose
# service `bgutil-pot-provider`). The default matches the plugin's built-in default;
# only set this when the provider lives somewhere other than localhost:4416.
# POT_PROVIDER_URL=http://127.0.0.1:4416

# Observability (OpenTelemetry)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=discord-music-bot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
