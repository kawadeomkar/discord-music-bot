# Runtime environment name — defaults to the current git branch (main → production).
# Set explicitly in environments without a git checkout (Docker, CI).
ENVIRONMENT=development

# Required
DISCORD_TOKEN=your_discord_bot_token
REDIS_URL=redis://localhost:6379

# Optional — Spotify link support. Set BOTH to enable playing Spotify tracks and
# playlists; leave both unset (or blank) to run without Spotify (YouTube, SoundCloud,
# other yt-dlp sites, and search still work). On startup the bot validates these
# credentials against the Spotify API (fetching a known track). If they're rejected,
# it logs an error and disables Spotify links — playback of other sources is
# unaffected, and `-ping` reports the current Spotify status.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Postgres play-history archive (docs/POSTGRES_HISTORY_PLAN.md). The server and
# its schema land ahead of the code that uses them — nothing in the bot reads or
# writes Postgres yet — but `docker compose up` brings it up and applies the
# migrations, so the tier is ready when that code arrives.
#
# POSTGRES_PASSWORD is MANDATORY and has no fallback: compose fails the command
# outright if it is unset or empty. Do not put a placeholder here — any
# non-empty value satisfies that check and would ship as the real credential.
# Run ./setup_env.sh to generate one. USER and DB default to "musicbot".
# POSTGRES_USER=musicbot
POSTGRES_PASSWORD=
# POSTGRES_DB=musicbot
#
# Host port the bundled Postgres publishes on (loopback only). The `just db-*`
# recipes run on the host and connect through this port — change it if
# something else on your machine already owns 5432.
# POSTGRES_HOST_PORT=5432
#
# Running Postgres yourself instead of the compose service? Set the URL
# directly; `just db-migrate` reads it, and it takes precedence over the host
# DSN the recipes would otherwise build from the parts above. The schema is
# never created by the bot — run `just db-migrate` against it.
# POSTGRES_URL=postgresql://user:password@host:5432/dbname
#
# DSN for `just db-migrate` only, so the migrating role can hold DDL rights the
# bot's role does not. Falls back to POSTGRES_URL.
# POSTGRES_MIGRATE_URL=postgresql://ddl_user:password@host:5432/dbname
#
# Ceiling on the play-history outbox, in entries. 0 (the default) means
# UNBOUNDED, and that is the durability contract: an entry only leaves the
# outbox once Postgres has it. Setting a cap is choosing to DISCARD the oldest
# un-archived plays — real, unrecoverable data loss — in exchange for bounding a
# non-evictable Redis key during a long Postgres outage. Every drop logs at
# ERROR. Must be >= 0; a negative value is refused at startup (it would read as
# an active cap and empty the outbox on every drain).
# HISTORY_OUTBOX_MAX=0
#
# asyncpg prepared-statement cache size, per connection. Set to 0 behind
# PgBouncer in transaction-pooling mode, where each transaction may get a
# different backend and a cached statement handle refers to something that
# backend has never prepared.
# POSTGRES_STATEMENT_CACHE=100

# Optional — where the bgutil PO-token provider sidecar listens (docker-compose
# service `bgutil-pot-provider`). The default matches the plugin's built-in default;
# only set this when the provider lives somewhere other than localhost:4416.
# POT_PROVIDER_URL=http://127.0.0.1:4416

# Observability (OpenTelemetry)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=discord-music-bot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
